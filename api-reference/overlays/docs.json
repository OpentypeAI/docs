    {
      "target": "$.paths['/v1/runs'].post",
      "update": {
        "description": "Submits a verdict or decision run and returns its answer. `Idempotency-Key` is required; replaying a key returns the stored run and never charges twice. `200` means the run is terminal; `202` means a replayed key found the run still in flight. See [Errors](/errors) for every refusal."
      }
    },
    {
      "target": "$.paths['/v1/runs/{run_id}/stream'].get",
      "update": {
        "description": "Observes a run as `text/event-stream`. Reads durable state only and never calls a provider, so observing a run cannot charge for it. Emits one `state` event and, when the run is terminal, one `terminal` event with the digests and the whole answer, then closes. There are no partial-token events. See [Streaming](/guides/streaming)."
      }
    },
    {
      "target": "$.paths['/v1/keys/{key_id}/rotate'].post",
      "update": {
        "description": "Issues a new secret for an existing key and returns it once. The old secret stops working immediately; there is no overlap window. A revoked key cannot be rotated (`409 key_revoked`)."
      }
    },
    {
      "target": "$.paths['/v1/members/invitations'].post",
      "update": {
        "description": "Invites someone at a role. A role above the caller's own is refused (`403 role_exceeds_caller`)."
      }
    },
    {
      "target": "$.paths['/v1/quota'].get",
      "update": {
        "description": "The organization's quota limits and what is left in the current period. These are the same numbers run admission enforces. Requires `usage_read`."
      }
    },
    {
      "target": "$.components.schemas.CreateRunRequest",
      "update": {
        "description": "A run submission: a verdict (`messages` + `schema`) or a decision (`state` + `questions`), selected by `kind` (default `verdict`). There is no `model` field; the route is chosen from the catalog. Unknown fields are rejected, and fields that belong to the other kind are `400 invalid_body`."
      }
    }
